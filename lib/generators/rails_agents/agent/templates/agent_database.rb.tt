# frozen_string_literal: true

class <%= class_name %> < RailsAgents::KnowledgeAgent
  model :gpt_5_mini, provider: :openai, credential: :company_openai
  memory :conversation
  knowledge_from "knowledge/**/*"

  # Generic read-only access to the connected Rails database.
  tool :sql_query do |sql:|
    text = sql.to_s.strip
    return { error: "sql is required" } if text.empty?

    normalized = text.sub(/;\s*\z/, "")
    unless normalized.match?(/\A\s*(WITH|SELECT)\b/im)
      return { error: "Only read-only SELECT/WITH queries are allowed" }
    end
    if normalized.match?(/\b(INSERT|UPDATE|DELETE|DROP|ALTER|TRUNCATE|CREATE|GRANT|REVOKE|COPY|EXECUTE|CALL)\b/i)
      return { error: "Write or DDL statements are not allowed" }
    end

    limited = normalized.match?(/\bLIMIT\b/i) ? normalized : "#{normalized} LIMIT 50"
    rows = ActiveRecord::Base.connection.exec_query(limited).to_a
    { ok: true, row_count: rows.length, rows: rows.first(50) }
  end

  channel :web
end
