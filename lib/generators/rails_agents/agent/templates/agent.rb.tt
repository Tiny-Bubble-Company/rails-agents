# frozen_string_literal: true

class <%= class_name %> < RailsAgents::<%= agent_base_class %>
  model "openrouter/free", provider: :rails_agent
  memory :conversation
  knowledge_from "knowledge/**/*"

  tool :ping do
    { status: "ok", agent: "<%= file_name %>" }
  end

  skill :triage, from: "skills/triage.rb"
  channel :slack
end
