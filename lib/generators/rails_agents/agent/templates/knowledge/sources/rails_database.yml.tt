# Rails app database knowledge source — attached by default on agent create.
# Detach from the Knowledge tab to remove full-DB Tool Bridge access for this agent.
type: rails_database
adapter: <%= include_mongo_query? && !include_sql_query? ? "mongoid" : "activerecord" %>
engines:
<% discovery_engines.each do |engine| -%>
  - <%= engine %>
<% end -%>
scope: full_database
tables: "*"
mode: read_only
connected_at: <%= Time.now.utc.iso8601 %>
