<% if notice.present? %>
  <div class="rails-agents-flash"><%= notice %></div>
<% end %>
<% if alert.present? %>
  <div class="rails-agents-flash rails-agents-flash--alert"><%= alert %></div>
<% end %>

<% if configured? %>
  <div class="rails-agents-embed-shell">
    <div class="rails-agents-embed-bar">
      <span>Rails Agent · connected</span>
      <%= link_to "Open in new tab", @dashboard_url, target: "_blank", rel: "noopener" %>
    </div>
    <iframe
      class="rails-agents-embed"
      src="<%= @dashboard_url %>"
      title="Rails Agent Cloud dashboard"
      allow="clipboard-write"
    ></iframe>
  </div>
<% else %>
  <div class="rails-agents-hero">
    <h1>Connect this app to Rails Agent Cloud</h1>
    <p class="rails-agents-lead">
      Like Sidekiq&rsquo;s <code>/sidekiq</code> — visit <code>/agents</code>, sign up once,
      and Kip embeds your cloud dashboard here.
    </p>
  </div>

  <section class="rails-agents-panel">
    <h2>Sign up / sign in</h2>
    <p>We&rsquo;ll save your API key to <code>config/rails_agents_credentials.yml</code> (and append <code>.env</code> if present).</p>

    <%= form_with url: rails_agents.handshake_path, method: :post, local: true, class: "rails-agents-form" do |f| %>
      <label>
        Workspace
        <input type="text" name="workspace" placeholder="<%= Rails.application.class.module_parent_name %>" />
      </label>
      <label>
        Email
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>
        Password
        <input type="password" name="password" required minlength="8" autocomplete="new-password" />
      </label>
      <button type="submit" class="rails-agents-button">Connect →</button>
    <% end %>

    <p class="rails-agents-muted">
      Or run <code>rails-agents login</code> and set <code>RAILS_AGENTS_API_KEY</code>.
      Docs: <a href="https://meerkatagents.com/docs/getting-started" target="_blank" rel="noopener">getting started</a>
    </p>
  </section>
<% end %>
