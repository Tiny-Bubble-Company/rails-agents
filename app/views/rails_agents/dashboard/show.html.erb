<% if notice.present? %>
  <div class="rails-agents-flash"><%= notice %></div>
<% end %>
<% if alert.present? %>
  <div class="rails-agents-flash rails-agents-flash--alert"><%= alert %></div>
<% end %>

<% if configured? %>
  <div class="rails-agents-embed-shell">
    <div class="rails-agents-embed-bar">
      <span>Rails Agent - connected</span>
      <span id="rails-agents-sync-status" class="rails-agents-sync-status" aria-live="polite"></span>
      <%= link_to "Open in new tab", @dashboard_url, target: "_blank", rel: "noopener" %>
    </div>
    <iframe
      id="rails-agents-dashboard-frame"
      class="rails-agents-embed"
      src="<%= @dashboard_url %>"
      title="Rails Agent Cloud dashboard"
      allow="clipboard-write"
    ></iframe>
  </div>

  <script>
    (function () {
      var PULL_URL = <%= raw rails_agents.pull_path.to_json %>;
      var CSRF = document.querySelector('meta[name="csrf-token"]');
      var statusEl = document.getElementById("rails-agents-sync-status");
      var ALLOWED = {
        "https://cloud.rails-agent.com": true,
        "http://localhost:3000": true,
        "http://127.0.0.1:3000": true,
        "http://localhost:8080": true,
        "http://127.0.0.1:8080": true
      };

      function setStatus(text, isError) {
        if (!statusEl) return;
        statusEl.textContent = text || "";
        statusEl.classList.toggle("rails-agents-sync-status--error", !!isError);
      }

      async function pullAgent(agentId) {
        var headers = {
          "Accept": "application/json",
          "Content-Type": "application/json"
        };
        if (CSRF) headers["X-CSRF-Token"] = CSRF.getAttribute("content");

        var res = await fetch(PULL_URL, {
          method: "POST",
          credentials: "same-origin",
          headers: headers,
          body: JSON.stringify({ agent_id: agentId })
        });
        var json = {};
        try { json = await res.json(); } catch (e) { json = {}; }
        if (!res.ok || json.ok === false) {
          throw new Error(json.error || ("Pull failed (" + res.status + ")"));
        }
        return json;
      }

      window.addEventListener("message", function (event) {
        if (!ALLOWED[event.origin]) return;
        var data = event.data || {};
        if (data.type !== "rails-agents:pull") return;
        if (!data.agentId) return;

        setStatus("Writing app/agents/...");
        pullAgent(data.agentId)
          .then(function (result) {
            setStatus("Synced " + (result.count || 0) + " files -> app/agents/" + result.slug + "/");
            if (event.source && event.source.postMessage) {
              event.source.postMessage({
                type: "rails-agents:pull-result",
                requestId: data.requestId,
                ok: true,
                count: result.count,
                slug: result.slug,
                written: result.written
              }, event.origin);
            }
          })
          .catch(function (err) {
            setStatus(err.message || "Pull failed", true);
            if (event.source && event.source.postMessage) {
              event.source.postMessage({
                type: "rails-agents:pull-result",
                requestId: data.requestId,
                ok: false,
                error: err.message || "Pull failed"
              }, event.origin);
            }
          });
      });
    })();
  </script>
<% else %>
  <%
    cloud = RailsAgents.config.dashboard_base.to_s.chomp("/")
    cloud = "https://cloud.rails-agent.com" if cloud.blank?
    return_to = "#{cloud}/dashboard?onboarding=1"
  %>
  <div class="rails-agents-hero">
    <h1>Connect this Rails app</h1>
    <p class="rails-agents-lead">
      Like Sidekiq&rsquo;s <code>/sidekiq</code>. Sign up once - then vibe-code agents
      here; files write into <code>app/agents/</code> on this machine.
    </p>
  </div>

  <section class="rails-agents-panel">
    <h2>Sign up / sign in</h2>
    <p class="rails-agents-muted" style="margin-top:0">
      Fastest path: continue on Rails Agent Cloud, then come back - we&rsquo;ll store your API key.
    </p>

    <div style="display:flex; flex-direction:column; gap:0.75rem; margin: 1.25rem 0;">
      <a class="rails-agents-button" style="text-align:center; text-decoration:none; display:block;"
         href="<%= cloud %>/api/v1/auth/github?return_to=<%= ERB::Util.url_encode(return_to) %>">
        Continue with GitHub
      </a>
      <a class="rails-agents-button" style="text-align:center; text-decoration:none; display:block; background:#0F0F10;"
         href="<%= cloud %>/signup?from=agents">
        Continue with email
      </a>
    </div>

    <hr style="border:0; border-top:1px solid var(--border); margin: 1.5rem 0;" />

    <h3 style="font-family: Fraunces, Georgia, serif; margin: 0 0 0.5rem;">Already have a code / API key?</h3>
    <p class="rails-agents-muted">Paste the sandbox API key from the cloud dashboard (Settings), or finish email signup there and paste it here.</p>

    <%= form_with url: rails_agents.handshake_path, method: :post, local: true, class: "rails-agents-form" do |f| %>
      <label>
        Workspace
        <input type="text" name="workspace" placeholder="<%= Rails.application.class.module_parent_name rescue 'MyApp' %>" />
      </label>
      <label>
        Email
        <input type="email" name="email" autocomplete="email" />
      </label>
      <label>
        Password <span class="rails-agents-muted">(legacy) or leave blank if using API key below</span>
        <input type="password" name="password" minlength="8" autocomplete="current-password" />
      </label>
      <label>
        API key <span class="rails-agents-muted">(rak_sandbox_...)</span>
        <input type="text" name="api_key" autocomplete="off" placeholder="rak_sandbox_..." />
      </label>
      <button type="submit" class="rails-agents-button">Connect this app -></button>
    <% end %>

    <p class="rails-agents-muted">
      Docs: <a href="https://cloud.rails-agent.com/docs/getting-started" target="_blank" rel="noopener">getting started</a>
    </p>
  </section>
<% end %>
