<div class="ra-grid ra-grid-2">
  <section class="ra-card">
    <h1>Create your account</h1>
    <p class="ra-muted">
      Sign up on Rails Agents Cloud without leaving your app. Free to define agents.
      Hosted runs need prepaid Credits (min $10).
    </p>

    <%= form_with url: signup_path, method: :post, local: true do %>
      <div class="ra-field">
        <label for="full_name">Full name</label>
        <input id="full_name" name="full_name" required autocomplete="name">
      </div>
      <div class="ra-field">
        <label for="email">Work email</label>
        <input id="email" name="email" type="email" required autocomplete="email">
      </div>
      <div class="ra-field">
        <label for="company_name">Company name</label>
        <input id="company_name" name="company_name" autocomplete="organization">
      </div>
      <div class="ra-field">
        <label for="company_website">Company website</label>
        <input id="company_website" name="company_website" autocomplete="url">
      </div>
      <button class="ra-btn" type="submit">Create account &amp; open dashboard</button>
    <% end %>
  </section>

  <section class="ra-card">
    <h2>Already have keys?</h2>
    <p class="ra-muted">Paste your Cloud credentials to use this dashboard on your domain.</p>

    <%= form_with url: connect_path, method: :post, local: true do %>
      <div class="ra-field">
        <label for="api_key">API key</label>
        <input id="api_key" name="api_key" required placeholder="rak_sandbox_… or rak_live_…">
      </div>
      <div class="ra-field">
        <label for="app_id">App ID</label>
        <input id="app_id" name="app_id" placeholder="app_…">
      </div>
      <div class="ra-field">
        <label for="bridge_secret">Bridge secret</label>
        <input id="bridge_secret" name="bridge_secret" placeholder="bridge secret">
      </div>
      <button class="ra-btn ra-btn-alt" type="submit">Connect</button>
    <% end %>

    <p class="ra-muted" style="margin-top:1.25rem">
      Or continue on
      <%= link_to "agents.meerkatagents.com/signup", "#{dashboard_url}/signup?return_to=#{u(request.original_url)}", target: "_blank", rel: "noopener" %>.
    </p>
  </section>
</div>
