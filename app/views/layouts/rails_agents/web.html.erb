<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Rails Agents</title>
    <style>
      :root {
        --ra-bg: #0c0a09;
        --ra-panel: #1c1917;
        --ra-border: #292524;
        --ra-text: #fafaf9;
        --ra-muted: #a8a29e;
        --ra-accent: #ea580c;
        --ra-accent-soft: #fb923c;
        --ra-ok: #34d399;
        --ra-warn: #fbbf24;
        --ra-bad: #f87171;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
        background: var(--ra-bg);
        color: var(--ra-text);
        line-height: 1.5;
      }
      a { color: var(--ra-accent-soft); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .ra-shell { max-width: 1100px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      .ra-top {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
        gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--ra-border);
      }
      .ra-brand { font-weight: 700; letter-spacing: -0.02em; font-size: 1.15rem; }
      .ra-brand span { color: var(--ra-accent-soft); }
      .ra-nav { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; font-size: 0.9rem; }
      .ra-pill {
        display: inline-block; padding: 0.15rem 0.55rem; border-radius: 999px;
        border: 1px solid var(--ra-border); color: var(--ra-muted); font-size: 0.75rem;
      }
      .ra-flash {
        padding: 0.85rem 1rem; border-radius: 10px; margin-bottom: 1.25rem;
        border: 1px solid var(--ra-border); background: var(--ra-panel);
      }
      .ra-flash-alert { border-color: #7f1d1d; color: #fecaca; }
      .ra-flash-notice { border-color: #9a3412; color: #ffedd5; }
      .ra-grid { display: grid; gap: 1.25rem; }
      @media (min-width: 900px) {
        .ra-grid-2 { grid-template-columns: 1.1fr 0.9fr; }
        .ra-layout { grid-template-columns: 200px 1fr; }
      }
      .ra-card {
        background: var(--ra-panel); border: 1px solid var(--ra-border);
        border-radius: 12px; padding: 1.25rem 1.35rem;
      }
      .ra-card h1, .ra-card h2, .ra-card h3 { margin: 0 0 0.65rem; }
      .ra-muted { color: var(--ra-muted); font-size: 0.95rem; }
      .ra-btn {
        display: inline-flex; align-items: center; justify-content: center;
        padding: 0.6rem 1rem; border-radius: 8px; border: 1px solid transparent;
        font-weight: 600; font-size: 0.9rem; cursor: pointer; background: var(--ra-accent); color: #fff;
      }
      .ra-btn:hover { filter: brightness(1.08); text-decoration: none; }
      .ra-btn-alt { background: transparent; border-color: var(--ra-border); color: var(--ra-text); }
      .ra-field { display: grid; gap: 0.35rem; margin-bottom: 0.85rem; }
      .ra-field label { font-size: 0.85rem; color: var(--ra-muted); }
      .ra-field input {
        width: 100%; padding: 0.6rem 0.75rem; border-radius: 8px;
        border: 1px solid var(--ra-border); background: #0c0a09; color: var(--ra-text);
      }
      table.ra-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
      table.ra-table th, table.ra-table td {
        text-align: left; padding: 0.7rem 0.4rem; border-bottom: 1px solid var(--ra-border);
      }
      table.ra-table th { color: var(--ra-muted); font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }
      .ra-status-deployed { color: var(--ra-ok); }
      .ra-status-error { color: var(--ra-bad); }
      .ra-status-draft, .ra-status-paused { color: var(--ra-warn); }
      .ra-aside a { display: block; padding: 0.45rem 0.65rem; border-radius: 8px; color: var(--ra-muted); margin-bottom: 0.25rem; }
      .ra-aside a.is-active, .ra-aside a:hover { background: #292524; color: var(--ra-text); text-decoration: none; }
      .ra-code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8rem; background: #0c0a09; border: 1px solid var(--ra-border);
        border-radius: 8px; padding: 0.85rem 1rem; overflow-x: auto; white-space: pre;
      }
      .ra-stat { font-size: 1.4rem; font-weight: 700; }
    </style>
  </head>
  <body>
    <div class="ra-shell">
      <header class="ra-top">
        <div class="ra-brand">Rails <span>Agents</span></div>
        <nav class="ra-nav">
          <% if connected? %>
            <span class="ra-pill"><%= environment_label %></span>
            <%= link_to "Cloud dashboard", "#{dashboard_url}/dashboard", target: "_blank", rel: "noopener" %>
            <%= link_to "Billing", "#{dashboard_url}/dashboard/billing", target: "_blank", rel: "noopener" %>
            <%= button_to "Disconnect", disconnect_path, method: :post, class: "ra-btn ra-btn-alt", form: { style: "display:inline" } %>
          <% else %>
            <%= link_to "Docs", "https://rails.meerkatagents.com", target: "_blank", rel: "noopener" %>
          <% end %>
        </nav>
      </header>

      <% if flash[:alert].present? %>
        <div class="ra-flash ra-flash-alert"><%= flash[:alert] %></div>
      <% end %>
      <% if flash[:notice].present? %>
        <div class="ra-flash ra-flash-notice"><%= flash[:notice] %></div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
